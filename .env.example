# Copy this file to .env and fill in your key. Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Check the current model names at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Where the Streamlit frontend finds the FastAPI backend
LEARNMIND_API=http://127.0.0.1:8000

# Optional tuning (these are the defaults)
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_WORDS=300
# CHUNK_OVERLAP=50
# TOP_K=4
