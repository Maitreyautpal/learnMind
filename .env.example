# Copy this file to .env. Leave GROQ_API_KEY empty until you have a key: the app then runs in offline mode.
GROQ_API_KEY=

# Check the current model names at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Where the Streamlit frontend finds the FastAPI backend (local default)
LEARNMIND_API=http://127.0.0.1:8000

# Optional tuning (these are the defaults)
# EMBEDDER=auto            # auto | st | fastembed | hash
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_WORDS=300
# CHUNK_OVERLAP=50
# TOP_K=4
# LEARNMIND_DATA_DIR=data   # folder of learnmind.db
